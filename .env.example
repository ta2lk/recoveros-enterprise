# Never commit real values. Configure these through OCI Vault/secret injection.
GEMINI_API_KEY="SET_IN_SECRET_MANAGER"
APP_URL="https://app.example.com"
NODE_ENV="production"
PORT="3000"
TRUST_PROXY="true"
# Minimum 32 random UTF-8 bytes; rotate through OCI Vault.
RECOVEROS_JWT_SECRET="SET_IN_SECRET_MANAGER"
# Exactly 64 hexadecimal characters; use OCI KMS/Vault in production.
RECOVEROS_MASTER_KEK_HEX="SET_IN_SECRET_MANAGER"
# Optional database connection string for the production persistence adapter.
DATABASE_URL="SET_IN_SECRET_MANAGER"
REDIS_URL="SET_IN_SECRET_MANAGER"
OBJECT_STORAGE_DRIVER="s3"
OBJECT_STORAGE_SSE_KMS_KEY_ID="SET_IN_SECRET_MANAGER"
