tenancy_ocid     = "ocid1.tenancy.oc1..REPLACE_ME"
user_ocid        = "ocid1.user.oc1..REPLACE_ME"
fingerprint      = "REPLACE_ME"
private_key_path = "/secure/path/oci_api_key.pem"
region           = "eu-frankfurt-1"
compartment_id   = "ocid1.compartment.oc1..REPLACE_ME"

project_name = "recoveros"

# Use a strong password from a secret manager. Never commit the real value.
postgres_admin_password = "REPLACE_ME_IN_SECRET_MANAGER"

# OCI Vault master key OCID used for bucket SSE-KMS.
kms_key_id = "ocid1.key.oc1..REPLACE_ME"

# Keep false when the application will run on OKE, Container Instances, or another managed runtime.
enable_compute = false
