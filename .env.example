# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 32-byte document envelope-encryption KEK, supplied by KMS/Secret Manager.
# Generate locally with: openssl rand -hex 32
RECOVEROS_MASTER_KEK_HEX="REPLACE_WITH_64_HEX_CHARACTERS"

# Required for durable production readiness; do not use an in-memory store in production.
DATABASE_URL="postgresql://user:password@host:5432/recoveros"

# S3-compatible encrypted object storage. Required in production.
OBJECT_STORAGE_BUCKET="recoveros-documents"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_SSE_KMS_KEY_ID="alias/recoveros-documents"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

# Local-only durable adapter for integration tests; never use in production.
OBJECT_STORAGE_DRIVER="s3"
OBJECT_STORAGE_LOCAL_DIR=".object-storage"

# Backup operations use a separate least-privilege operational credential.
BACKUP_DATABASE_URL="postgresql://backup-user:password@host:5432/recoveros"
RESTORE_DATABASE_URL="postgresql://backup-user:password@host:5432/recoveros"
BACKUP_DIR="./backups"
BACKUP_BUCKET="recoveros-backup"
BACKUP_PREFIX="backups"
BACKUP_UPLOAD="false"

# Only set to true in isolated automated tests. Never enable in production.
RECOVEROS_TEST_MODE="false"
